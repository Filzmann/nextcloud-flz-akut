<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>flz_akut</id>
    <name>Akutschichtvermittlung</name>
    <summary>Vermittlung kurzfristig offener Assistenzschichten.</summary>
    <description>Verwaltet offene Schichten, Kontaktversuche, Vermittlung und manuelle Dokumentationsnachweise bürobezogen.</description>
    <version>0.1.0-dev.1</version>
    <licence>agpl</licence>
    <author>Filzmann Software</author>
    <namespace>FlzAkut</namespace>
    <category>organization</category>
    <website>https://github.com/Filzmann/flz-full-suite</website>
    <bugs>https://github.com/Filzmann/nextcloud-flz-akut/issues</bugs>
    <repository type="git">https://github.com/Filzmann/nextcloud-flz-akut</repository>
    <dependencies><php min-version="8.3"/><nextcloud min-version="33" max-version="35"/></dependencies>
    <background-jobs><job>OCA\FlzAkut\BackgroundJob\RetentionJob</job></background-jobs>
    <settings>
        <admin>OCA\FlzAkut\Settings\Admin</admin>
        <admin-section>OCA\FlzAkut\Settings\AdminSection</admin-section>
        <personal>OCA\FlzAkut\Settings\PersonalProfile</personal>
        <personal-section>OCA\FlzAkut\Settings\PersonalProfileSection</personal-section>
    </settings>
</info>
